# DecisionOS analytics API configuration.
# Copy to .env before running docker compose.

# Directory where SQLite state and uploaded/scored artifacts are stored.
DECISIONOS_DATA_DIR=./var/worker

# Set to 1 to require signed JWTs on every API request. When enabled,
# DECISIONOS_JWT_SECRET must be at least 32 bytes.
DECISIONOS_AUTH_STRICT=0
DECISIONOS_JWT_SECRET=replace-with-at-least-32-random-bytes

# Development-only: allows the demo token mint endpoint. Keep 0 in production.
DECISIONOS_ALLOW_TOKEN_MINT=1

# Port the uvicorn API binds to.
PORT=8100
