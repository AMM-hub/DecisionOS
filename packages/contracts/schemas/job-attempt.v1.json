{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisionos.example/schemas/job/1.0",
  "title": "DecisionOS Job attempt record (spec 23.5)",
  "type": "object",
  "required": ["job_id", "attempt", "state", "lease", "budget", "input_digest", "code_version"],
  "properties": {
    "job_id": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "state": {
      "type": "string",
      "enum": ["queued", "leased", "running", "validating", "publishing", "succeeded", "retry_wait", "failed", "cancel_requested", "cancelled", "expired"],
      "description": "queued -> leased -> running -> validating -> publishing -> succeeded, with branches"
    },
    "lease": {
      "type": "object",
      "required": ["owner", "expires_at"],
      "properties": {
        "owner": { "type": "string" },
        "expires_at": { "type": "string", "format": "date-time" },
        "last_heartbeat_at": { "type": "string", "format": "date-time" }
      },
      "description": "An independent lease sweeper marks abandoned runs; queue acknowledgement is never completion."
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_seconds": { "type": "number" },
        "max_memory_mb": { "type": "number" },
        "max_rows": { "type": "integer" }
      }
    },
    "input_digest": { "type": "string" },
    "code_version": { "type": "string" },
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "failure_code": { "type": "string" },
    "output_refs": { "type": "array", "items": { "type": "string" } }
  }
}
